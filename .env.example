# URL y clave publica (anon) del proyecto de Supabase.
# Se consiguen en: Supabase Dashboard -> Project Settings -> API.
# La anon key es publica por diseno: toda la seguridad real la hacen las
# politicas RLS y las funciones SECURITY DEFINER de supabase/migrations,
# no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (Project Settings -> API). Sensible: nunca se expone al
# navegador. La usan los scripts de bootstrap y las Server Actions que crean
# cuentas de acceso (dirigentes, administradores de organizacion).
SUPABASE_SERVICE_ROLE_KEY=

# API key de Resend (resend.com/api-keys) para los reportes automaticos por
# email. Sin esto, "Enviar prueba" y el envio diario fallan con un error
# claro, pero el resto de la app funciona igual.
RESEND_API_KEY=
# Opcional: remitente propio ya verificado en Resend (Domains). Si se deja
# vacio, se usa el dominio de prueba de Resend (onboarding@resend.dev), que
# solo permite mandar al correo de la cuenta.
RESEND_FROM_EMAIL=

# Secreto compartido para /api/cron/daily (el cron diario de reportes por
# email). Generar un valor random propio y cargarlo tambien en Vercel ->
# Project Settings -> Environment Variables -> CRON_SECRET (Vercel lo manda
# solo en el header Authorization cuando dispara el cron).
CRON_SECRET=

# Personal Access Token de GitHub (fine-grained, scope "Actions: Read and
# write" sobre este repo) para que el boton "Generar respaldo ahora" pueda
# disparar el workflow de backup via la API de GitHub. Sin esto, ese boton
# falla con un error claro; el backup automatico diario no lo necesita (ese
# lo dispara el cron de GitHub Actions solo).
GITHUB_ACTIONS_TOKEN=
